# ==========================================
# BARENGYIN CONFIGURATION ENVIRONMENT
# ==========================================

# 1. Supabase (Database, Auth, Storage, Realtime)
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. AI Receipt Scan (Qwen-VL via QwenCloud / Claude)
# Region: Singapore (dashscope-intl.aliyuncs.com/apps/anthropic)
AI_PROVIDER=qwen
QWEN_API_KEY=sk-ws-H.your-qwen-api-key-here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/apps/anthropic
QWEN_VL_MODEL=qwen-vl-plus

# Alternatif jika berpindah ke Claude asli (Haiku):
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# 3. Cloudflare Turnstile (Bot Protection)
# Di development lokal, default menggunakan testing keys resmi Cloudflare jika kosong.
# Untuk production di Vercel, isi dengan Site Key & Secret Key dari Cloudflare Dashboard:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 4. App URL (Opsional, otomatis membaca window.location.origin jika kosong)
# NEXT_PUBLIC_APP_URL=https://barengyin.vercel.app

